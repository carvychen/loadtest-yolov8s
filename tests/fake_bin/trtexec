#!/usr/bin/env python3
"""测试用假 trtexec: 记录参数, 按真实格式输出日志, 不需要 GPU。
FAKE_TRT_VER: 如 101302 / 110300; FAKE_TRTEXEC_CALLS: 每次调用的参数追加到这个文件 (一行一次, shlex 拼接)。
测速调用回放 tests/fixtures/trt<major>-b8-<compute|transfer>.log。"""
import os
import shlex
import sys
from pathlib import Path

args = sys.argv[1:]
ver = int(os.environ.get("FAKE_TRT_VER", "101302"))
major = ver // 10000
if os.environ.get("FAKE_TRTEXEC_CALLS"):
    with open(os.environ["FAKE_TRTEXEC_CALLS"], "a") as f:
        f.write(shlex.join(args) + "\n")
opt = {a.split("=", 1)[0]: a.split("=", 1)[1] for a in args if "=" in a}

if "--help" in args:
    # 故意写到 stderr: 调用方必须合并 stderr 才能拿到版本 (旧脚本用的是 2>&1)
    print(f"&&&& RUNNING TensorRT.trtexec [TensorRT v{ver}] [b1] # trtexec --help", file=sys.stderr)
elif "--saveEngine" in opt:
    Path(opt["--saveEngine"]).write_bytes(b"fake plan")
    print(f"[I] TensorRT version: {major}.{ver // 100 % 100}.{ver % 100}")
elif "--exportProfile" in opt:
    Path(opt["--exportProfile"]).write_text("[]")
    Path(opt["--exportLayerInfo"]).write_text("{}")
else:
    transfer = "--includeDataTransfers" in args or (major < 11 and "--noDataTransfers" not in args)
    log = Path(__file__).parent.parent / "fixtures" / f"trt{major}-b8-{'transfer' if transfer else 'compute'}.log"
    sys.stdout.write(log.read_text())
